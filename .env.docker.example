# Docker Compose 部署示例。复制为 .env 后按需填写：
#   cp .env.docker.example .env

# 宿主机监听端口
RECAP_HTTP_PORT=8000

# 容器内持久化路径；默认通过 docker-compose.yml 挂载到宿主机 ./data。
RECAP_DOCKER_DB_PATH=/data/recap_system.db
RECAP_DOCKER_OUTPUT_DIR=/data/reports

# ─── LLM 后端 ─────────────────────────────────────────────────────────────────
# openai / ollama / cursor-cli / gemini-cli；留空时应用默认 openai。
RECAP_LLM_BACKEND=
RECAP_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=

# ─── API 安全 ─────────────────────────────────────────────────────────────────
# 设置后，所有 /v1/* 接口需要 X-API-Key 请求头。
RECAP_API_KEY=
RECAP_CORS_ORIGINS=

# ─── 推送 ─────────────────────────────────────────────────────────────────────
RECAP_PUSH_ENABLED=false
RECAP_WXWORK_WEBHOOK_URL=

# ─── 调度 ─────────────────────────────────────────────────────────────────────
RECAP_SCHEDULER_ENABLED=false
RECAP_SCHEDULER_DAILY_HOUR=15
RECAP_SCHEDULER_DAILY_MINUTE=30

# ─── 可选向量记忆 ─────────────────────────────────────────────────────────────
RECAP_QDRANT_URL=
RECAP_QDRANT_API_KEY=
RECAP_QDRANT_COLLECTION=agent_platform_memory

RECAP_LOG_LEVEL=INFO

# ─── 微信公众号日终草稿（docker compose --profile wechat run --rm wechat-publish）──
WECHAT_APPID=
WECHAT_SECRET=
# WECHAT_AUTHOR=Agent Platform
# WECHAT_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# RECAP_AGENT_MAX_WALL_MS=600000
# TZ=Asia/Shanghai
# UV_BIN=/usr/local/bin/uv
